@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <a class="brand" href="/" aria-label="What Should I Work On Today home">
            <span class="brand-prompt" aria-hidden="true">~/</span>
            <span>work_today</span>
        </a>

        <nav aria-label="Main navigation">
            <NavLink href="/today">Chooser</NavLink>
            <NavLink href="/work-items">Work items</NavLink>
        </nav>
    </header>

    <main class="app-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

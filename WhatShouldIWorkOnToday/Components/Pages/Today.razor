@page "/today"
@using WhatShouldIWorkOnToday.Models
@using WhatShouldIWorkOnToday.Services
@inject WorkChooser WorkChooser
@inject NavigationManager Navigation
@inject PlanningClock PlanningClock

<PageTitle>What Should I Work On Today?</PageTitle>

<div class="app-page">
    <header class="page-heading">
        <p class="eyebrow">Today.exe</p>
        <h1>What Should I Work On Today?</h1>
        <p class="lead">
            Give the chooser a realistic resource budget.
            It will handle the indecision.
        </p>
    </header>

    <div class="today-top-grid">
        <section class="daily-pick-section"
                 aria-label="Daily pick">
            <div class="results-heading">
                <div>
                    <p class="eyebrow">Daily pick</p>
                    <h2>@_dailyDate.ToString("MMMM d, yyyy")</h2>
                </div>
            </div>

            @if (_dailyTodo is null)
            {
                <p class="empty-state">
                    No eligible daily pick.
                </p>
            }
            else
            {
                <ul class="choice-list single-choice">
                    <li class="choice-card">
                        <div class="choice-project">
                            <a href="@($"/work-items/{_dailyTodo.WorkItemId}")">
                                @_dailyTodo.WorkItem.Name
                            </a>
                        </div>

                        <div class="choice-task">
                            @_dailyTodo.Task
                        </div>

                        <div class="badge-row">
                            <span class="badge accent">
                                @_dailyTodo.Energy energy
                            </span>

                            <span class="badge">
                                @_dailyTodo.Effort effort
                            </span>

                            @if (_dailyTodo.WorkItem.Priority != PriorityLevel.Normal)
                            {
                                <span class="badge">
                                    @_dailyTodo.WorkItem.Priority work-item priority
                                </span>
                            }

                            @if (_dailyTodo.Priority != PriorityLevel.Normal)
                            {
                                <span class="badge">
                                    @_dailyTodo.Priority todo priority
                                </span>
                            }
                        </div>

                        @if (_dailyTodo.WorkItem.LastWorkedAt is null)
                        {
                            <div class="choice-context">
                                Never worked on.
                            </div>
                        }
                        else
                        {
                            <div class="choice-context">
                                Last worked:
                                @(_dailyTodo.WorkItem.LastWorkedAt.Value
                                    .ToLocalTime()
                                    .ToString("g"))
                            </div>
                        }

                        <div class="choice-actions row-actions">
                            <button type="button"
                                    class="small"
                                    @onclick="OpenDailyTodo">
                                Work on this
                            </button>
                        </div>
                    </li>
                </ul>
            }
        </section>

        <section class="random-pick-section"
                 aria-label="Random pick">
            <p class="eyebrow">Random pick</p>
            <h2>Leave it to chance</h2>

            @if (_randomTodo is null)
            {
                <p class="empty-state">
                    No active todos. Somehow you finished everything.
                </p>
            }
            else
            {
                <ul class="choice-list single-choice">
                    <li class="choice-card">
                        <label class="random-priority-option">
                            <input type="checkbox"
                                   @bind="_favorRandomPriority" />
                            <span>Favor priority</span>
                        </label>

                        <div class="choice-project">
                            <a href="@($"/work-items/{_randomTodo.WorkItemId}")">
                                @_randomTodo.WorkItem.Name
                            </a>
                        </div>

                        <div class="choice-task">
                            @_randomTodo.Task
                        </div>

                        <div class="badge-row">
                            <span class="badge accent">
                                @_randomTodo.Energy energy
                            </span>

                            <span class="badge">
                                @_randomTodo.Effort effort
                            </span>

                            @if (_randomTodo.Priority != PriorityLevel.Normal)
                            {
                                <span class="badge">
                                    @_randomTodo.Priority priority
                                </span>
                            }
                        </div>

                        @if (_randomTodo.WorkItem.LastWorkedAt is null)
                        {
                            <div class="choice-context">
                                Never worked on.
                            </div>
                        }
                        else
                        {
                            <div class="choice-context">
                                Last worked:
                                @(_randomTodo.WorkItem.LastWorkedAt.Value
                                    .ToLocalTime()
                                    .ToString("g"))
                            </div>
                        }

                        <div class="choice-actions row-actions">
                            <button type="button"
                                    class="small"
                                    @onclick="OpenRandomTodo">
                                Work on this
                            </button>

                            <button type="button"
                                    class="secondary small"
                                    @onclick="ChooseRandomAsync">
                                Nope, random again
                            </button>
                        </div>
                    </li>
                </ul>
            }
        </section>
    </div>

    <section class="panel chooser-panel"
             aria-label="Chooser filters">
        <div class="chooser-controls">
            <div class="form-field">
                <label>Energy</label>

                <InputSelect @bind-Value="_energy">
                    @foreach (var value in Enum.GetValues<EnergyLevel>())
                    {
                        <option value="@value">@value</option>
                    }
                </InputSelect>
            </div>

            <div class="form-field">
                <label>Available time / effort</label>

                <InputSelect @bind-Value="_effort">
                    @foreach (var value in Enum.GetValues<EffortLevel>())
                    {
                        <option value="@value">@value</option>
                    }
                </InputSelect>
            </div>

            <button type="button"
                    @onclick="ChooseAsync">
                Pick something
            </button>
        </div>
    </section>

    @if (_hasChosen)
    {
        <section class="results-section"
                 aria-live="polite">
            @if (_choices.Count == 0)
            {
                <p class="empty-state">
                    Nothing matches. Apparently Past You has failed Present You.
                </p>
            }
            else
            {
                <div class="results-heading">
                    <h2>How about...</h2>

                    <span class="count-label">
                        @_choices.Count options
                    </span>
                </div>

                <ul class="choice-list">
                    @foreach (var todo in _choices)
                    {
                        <li class="choice-card">
                            <div class="choice-project">
                                <a href="@($"/work-items/{todo.WorkItemId}")">
                                    @todo.WorkItem.Name
                                </a>
                            </div>

                            <div class="choice-task">
                                @todo.Task
                            </div>

                            <div class="badge-row">
                                <span class="badge accent">
                                    @todo.Energy energy
                                </span>

                                <span class="badge">
                                    @todo.Effort effort
                                </span>

                                @if (todo.WorkItem.Priority != PriorityLevel.Normal)
                                {
                                    <span class="badge">
                                        @todo.WorkItem.Priority work-item priority
                                    </span>
                                }

                                @if (todo.Priority != PriorityLevel.Normal)
                                {
                                    <span class="badge">
                                        @todo.Priority todo priority
                                    </span>
                                }
                            </div>

                            @if (todo.WorkItem.LastWorkedAt is null)
                            {
                                <div class="choice-context">
                                    Never worked on.
                                </div>
                            }
                            else
                            {
                                <div class="choice-context">
                                    Last worked:
                                    @(todo.WorkItem.LastWorkedAt.Value
                                        .ToLocalTime()
                                        .ToString("g"))
                                </div>
                            }

                            <div class="choice-actions row-actions">
                                <button type="button"
                                        class="small"
                                        @onclick="() => OpenWorkItem(todo)">
                                    Work on this
                                </button>
                            </div>
                        </li>
                    }
                </ul>

                <button type="button"
                        class="secondary"
                        @onclick="ChooseAsync">
                    Nah, give me something else
                </button>
            }
        </section>
    }
</div>

@code {
    private EnergyLevel _energy = EnergyLevel.Medium;
    private EffortLevel _effort = EffortLevel.Medium;

    private List<TodoItem> _choices = [];
    private bool _hasChosen;

    private TodoItem? _randomTodo;
    private bool _hasRandomChosen;
    private bool _favorRandomPriority;

    private TodoItem? _dailyTodo;
    private DateOnly _dailyDate;

    protected override async Task OnInitializedAsync()
    {
        _dailyDate = PlanningClock.Today();
        _dailyTodo = await WorkChooser.ChooseDailyAsync(_dailyDate);
        _randomTodo = await WorkChooser.ChooseRandomAsync(favorPriority: _favorRandomPriority);

        _hasRandomChosen = true;
    }

    private async Task ChooseAsync()
    {
        _choices = await WorkChooser.ChooseAsync(
            _energy,
            _effort);

        _randomTodo = null;
        _hasRandomChosen = false;
        _hasChosen = true;
    }

    private async Task ChooseRandomAsync()
    {
        _randomTodo = await WorkChooser.ChooseRandomAsync(
            favorPriority: _favorRandomPriority);

        _choices = [];
        _hasChosen = false;
        _hasRandomChosen = true;
    }

    private void OpenRandomTodo()
    {
        if (_randomTodo is null)
        {
            return;
        }

        Navigation.NavigateTo(
            $"/work-items/{_randomTodo.WorkItemId}");
    }

    private void OpenWorkItem(TodoItem todo)
    {
        Navigation.NavigateTo(
            $"/work-items/{todo.WorkItemId}");
    }

    private void OpenDailyTodo()
    {
        if (_dailyTodo is null)
        {
            return;
        }

        Navigation.NavigateTo(
            $"/work-items/{_dailyTodo.WorkItemId}");
    }
}
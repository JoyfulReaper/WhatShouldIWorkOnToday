@page "/work-items/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using WhatShouldIWorkOnToday.Data
@using WhatShouldIWorkOnToday.Models
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject NavigationManager Navigation

<PageTitle>@(_workItem?.Name ?? "Work Item")</PageTitle>

@if (_workItem is null)
{
    <div class="app-page panel not-found">
        <h1>Work item not found.</h1>
        <a class="back-link" href="/work-items">← Work Items</a>
    </div>
}
else
{
    <div class="app-page">
        <a class="back-link" href="/work-items">← Work Items</a>

        <header class="work-item-summary">
            <p class="eyebrow">Work item</p>

            @if (_editingWorkItem is not null)
            {
                var editingWorkItem = _editingWorkItem;

                <EditForm Model="editingWorkItem"
                          OnValidSubmit="SaveWorkItemAsync"
                          FormName="EditWorkItem"
                          class="panel form-panel form-grid work-item-edit-form">
                    <DataAnnotationsValidator />

                    <div class="form-field">
                        <label>Name</label>
                        <InputText @bind-Value="editingWorkItem.Name" />
                        <ValidationMessage For="() => editingWorkItem.Name" />
                    </div>

                    <div class="form-field">
                        <label>Kind</label>
                        <InputSelect @bind-Value="editingWorkItem.Kind">
                            @foreach (var value in Enum.GetValues<WorkItemKind>())
                            {
                                <option value="@value">@value</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="form-field wide">
                        <label>Description</label>
                        <InputTextArea @bind-Value="editingWorkItem.Description" />
                        <ValidationMessage For="() => editingWorkItem.Description" />
                    </div>

                    <div class="form-field wide">
                        <label>URL</label>
                        <InputText @bind-Value="editingWorkItem.Url" />
                        <ValidationMessage For="() => editingWorkItem.Url" />
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="small">Save</button>
                        <button type="button" class="secondary small" @onclick="CancelWorkItemEdit">Cancel</button>
                    </div>
                </EditForm>
            }
            else
            {
                <h1>@_workItem.Name</h1>

                @if (!string.IsNullOrWhiteSpace(_workItem.Description))
                {
                    <p class="description">@_workItem.Description</p>
                }

                @if (!string.IsNullOrWhiteSpace(_workItem.Url))
                {
                    <p class="work-item-url">
                        <a href="@_workItem.Url" target="_blank" rel="noopener noreferrer">@_workItem.Url</a>
                    </p>
                }

                <div class="badge-row">
                    <span class="badge accent">@_workItem.Kind</span>

                    @if (_workItem.CompletedAt is not null)
                    {
                        <span class="badge completed">Completed</span>
                    }

                    @if (_workItem.ArchivedAt is not null)
                    {
                        <span class="badge archived">Archived</span>
                    }
                </div>

                <div class="row-actions work-item-actions">
                    <button type="button" class="secondary small" @onclick="EditWorkItem">Edit</button>

                    <button type="button" class="small" @onclick="ToggleWorkItemCompletedAsync">
                        @(_workItem.CompletedAt is null ? "Complete" : "Reopen")
                    </button>

                    <button type="button" class="secondary small" @onclick="ToggleWorkItemArchivedAsync">
                        @(_workItem.ArchivedAt is null ? "Archive" : "Unarchive")
                    </button>

                    @if (!_confirmDeleteWorkItem)
                    {
                        <button type="button"
                                class="secondary small"
                                @onclick="ConfirmDeleteWorkItem">
                            Delete permanently
                        </button>
                    }
                </div>

                @if (_confirmDeleteWorkItem)
                {
                    <div class="panel">
                        <p>
                            This will permanently delete this work item,
                            all of its todos, and all of its work history.
                            This cannot be undone.
                        </p>

                        <div class="row-actions">
                            <button type="button"
                                    class="small"
                                    @onclick="DeleteWorkItemAsync">
                                Yes, permanently delete
                            </button>

                            <button type="button"
                                    class="secondary small"
                                    @onclick="CancelDeleteWorkItem">
                                Cancel
                            </button>
                        </div>
                    </div>
                }

                <div class="form-field work-note-field">
                    <label>Quick work note</label>

                    <InputTextArea @bind-Value="_workNote" placeholder="What did you actually do?" />

                    <button type="button"
                            class="small"
                            @onclick="MarkWorkedAsync">
                        Mark worked
                    </button>
                </div>
            }
        </header>

        <section class="panel form-panel new-todo-panel" aria-labelledby="new-todo-heading">
            <header class="form-panel-header">
                <h2 id="new-todo-heading">Add a todo</h2>
                <p>Small enough to start. Specific enough to finish.</p>
            </header>

            <EditForm Model="_newTodo"
                      OnValidSubmit="CreateTodoAsync"
                      FormName="CreateTodo"
                      class="todo-create-grid">
                <DataAnnotationsValidator />

                <div class="form-field">
                    <label>Task</label>
                    <InputText @bind-Value="_newTodo.Task" />
                    <ValidationMessage For="() => _newTodo.Task" />
                </div>

                <div class="form-field">
                    <label>Energy</label>
                    <InputSelect @bind-Value="_newTodo.Energy">
                        @foreach (var value in Enum.GetValues<EnergyLevel>())
                        {
                            <option value="@value">@value</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-field">
                    <label>Effort</label>
                    <InputSelect @bind-Value="_newTodo.Effort">
                        @foreach (var value in Enum.GetValues<EffortLevel>())
                        {
                            <option value="@value">@value</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-actions">
                    <button type="submit">Add todo</button>
                </div>
            </EditForm>
        </section>

        <section aria-labelledby="todos-heading">
            <div class="section-header">
                <h2 id="todos-heading">Todos</h2>
                <span class="count-label">
                    @FilteredTodos.Count() of @_workItem.Todos.Count
                </span>
            </div>

            <div class="form-field">
                <label for="todo-search">
                    Search todos
                </label>

                <input id="todo-search"
                       type="search"
                       placeholder="Search tasks..."
                       @bind="_todoSearch"
                       @bind:event="oninput" />
            </div>

            @if (_workItem.Todos.Count == 0)
            {
                <p class="empty-state">
                    No todos yet.
                </p>
            }
            else if (!FilteredTodos.Any())
            {
                <p class="empty-state">
                    No todos match your search.
                </p>
            }
            else
            {
                <ul class="todo-list">
                    @foreach (var todo in FilteredTodos
                        .OrderBy(x => x.CompletedAt.HasValue)
                        .ThenBy(x => x.CreatedAt))
                    {
                        <li class="todo-row @(todo.CompletedAt is not null ? "completed" : null)">
                            <button type="button"
                                    class="secondary small"
                                    @onclick="() => ToggleTodoAsync(todo.Id)">
                                @(todo.CompletedAt is null ? "Complete" : "Reopen")
                            </button>

                            @if (_editingTodo?.Id == todo.Id)
                            {
                                var editingTodo = _editingTodo;

                                <EditForm Model="editingTodo"
                                          OnValidSubmit="SaveTodoAsync"
                                          FormName="@($"EditTodo-{todo.Id}")"
                                          class="todo-edit-form">
                                    <DataAnnotationsValidator />

                                    <div class="form-field">
                                        <label>Task</label>
                                        <InputText @bind-Value="editingTodo.Task" />
                                        <ValidationMessage For="() => editingTodo.Task" />
                                    </div>

                                    <div class="form-field">
                                        <label>Energy</label>
                                        <InputSelect @bind-Value="editingTodo.Energy">
                                            @foreach (var value in Enum.GetValues<EnergyLevel>())
                                            {
                                                <option value="@value">@value</option>
                                            }
                                        </InputSelect>
                                    </div>

                                    <div class="form-field">
                                        <label>Effort</label>
                                        <InputSelect @bind-Value="editingTodo.Effort">
                                            @foreach (var value in Enum.GetValues<EffortLevel>())
                                            {
                                                <option value="@value">@value</option>
                                            }
                                        </InputSelect>
                                    </div>

                                    <div class="row-actions">
                                        <button type="submit" class="small">Save</button>
                                        <button type="button" class="secondary small" @onclick="CancelEdit">Cancel</button>
                                    </div>
                                </EditForm>
                            }
                            else
                            {
                                <div class="todo-content">
                                    <span class="todo-task">
                                        @if (todo.CompletedAt is null)
                                        {
                                            @todo.Task
                                        }
                                        else
                                        {
                                            <s>@todo.Task</s>
                                        }
                                    </span>

                                    <div class="badge-row">
                                        <span class="badge accent">@todo.Energy energy</span>
                                        <span class="badge">@todo.Effort effort</span>
                                    </div>
                                </div>

                                <div class="row-actions">
                                    <button type="button"
                                            class="secondary small"
                                            @onclick="() => EditTodo(todo)">
                                        Edit
                                    </button>

                                    @if (_confirmDeleteTodoId == todo.Id)
                                    {
                                        <button type="button"
                                                class="small"
                                                @onclick="() => DeleteTodoAsync(todo.Id)">
                                            Confirm delete
                                        </button>

                                        <button type="button"
                                                class="secondary small"
                                                @onclick="CancelDeleteTodo">
                                            Cancel
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="secondary small"
                                                @onclick="() => ConfirmDeleteTodo(todo.Id)">
                                            Delete
                                        </button>
                                    }
                                </div>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
        <section aria-labelledby="work-history-heading">
            <div class="section-header">
                <h2 id="work-history-heading">Work history</h2>
                <span class="count-label">
                    Recent @_workHistory.Count
                </span>
            </div>

            @if (_workHistory.Count == 0)
            {
                <p class="empty-state">
                    No work recorded yet.
                </p>
            }
            else
            {
                <ul class="work-item-list">
                    @foreach (var entry in _workHistory)
                    {
                        <li class="work-item-row">
                            <div>
                                <strong>
                                    @(entry.TaskSnapshot ?? "General work")
                                </strong>

                                @if (_editingHistoryId == entry.Id)
                                {
                                    <div class="form-field">
                                        <InputTextArea @bind-Value="_editingHistoryNote"
                                                       placeholder="What did you do?" />

                                        <div class="row-actions">
                                            <button type="button"
                                                    class="small"
                                                    @onclick="SaveHistoryNoteAsync">
                                                Save
                                            </button>

                                            <button type="button"
                                                    class="secondary small"
                                                    @onclick="CancelHistoryNoteEdit">
                                                Cancel
                                            </button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    @if (!string.IsNullOrWhiteSpace(entry.Note))
                                    {
                                        <div class="work-item-description">
                                            @entry.Note
                                        </div>
                                    }

                                    <button type="button"
                                            class="secondary small @(string.IsNullOrWhiteSpace(entry.Note) ? "history-add-note" : null)"
                                            @onclick="() => EditHistoryNote(entry)">
                                        @(string.IsNullOrWhiteSpace(entry.Note)
                                            ? "Add note"
                                            : "Edit note")
                                    </button>
                                }
                            </div>

                            <div class="work-item-meta">
                                <span class="last-worked">
                                    @(entry.WorkedAt.ToLocalTime().ToString("g"))
                                </span>
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private WorkItem? _workItem;
    private WorkItem? _editingWorkItem;
    private TodoItem _newTodo = new();
    private TodoItem? _editingTodo;
    private int? _confirmDeleteTodoId;
    private string? _workNote;
    private int? _editingHistoryId;
    private string? _editingHistoryNote;
    private List<WorkHistoryEntry> _workHistory = [];
    private bool _confirmDeleteWorkItem;
    private string _todoSearch = string.Empty;

    private IEnumerable<TodoItem> FilteredTodos
    {
        get
        {
            if (_workItem is null)
            {
                return [];
            }

            if (string.IsNullOrWhiteSpace(_todoSearch))
            {
                return _workItem.Todos;
            }

            var query = _todoSearch.Trim();

            return _workItem.Todos.Where(
                todo =>
                    todo.Task.Contains(query, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db =
            await DbContextFactory.CreateDbContextAsync();

        _workItem = await db.WorkItems
            .AsNoTracking()
            .Include(x => x.Todos)
            .SingleOrDefaultAsync(x => x.Id == Id);

        var history = await db.WorkHistoryEntries
            .AsNoTracking()
            .Where(x => x.WorkItemId == Id)
            .ToListAsync();

        _workHistory = history
            .OrderByDescending(x => x.WorkedAt)
            .Take(20)
            .ToList();
    }

    private void EditWorkItem()
    {
        if (_workItem is null)
            return;

        _editingWorkItem = new WorkItem
        {
            Id = _workItem.Id,
            Name = _workItem.Name,
            Description = _workItem.Description,
            Url = _workItem.Url,
            Kind = _workItem.Kind
        };
    }

    private void CancelWorkItemEdit()
    {
        _editingWorkItem = null;
    }

    private void ConfirmDeleteWorkItem()
    {
        _confirmDeleteWorkItem = true;
    }

    private void CancelDeleteWorkItem()
    {
        _confirmDeleteWorkItem = false;
    }

    private async Task DeleteWorkItemAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var workItem = await db.WorkItems.FindAsync(Id);

        if (workItem is null)
        {
            Navigation.NavigateTo("/work-items");
            return;
        }

        var todos = await db.TodoItems
            .Where(x => x.WorkItemId == Id)
            .ToListAsync();

        var history = await db.WorkHistoryEntries
            .Where(x => x.WorkItemId == Id)
            .ToListAsync();

        db.WorkHistoryEntries.RemoveRange(history);
        db.TodoItems.RemoveRange(todos);
        db.WorkItems.Remove(workItem);

        await db.SaveChangesAsync();

        Navigation.NavigateTo("/work-items");
    }

    private async Task SaveWorkItemAsync()
    {
        if (_editingWorkItem is null)
            return;

        await using var db =
            await DbContextFactory.CreateDbContextAsync();

        var workItem = await db.WorkItems.FindAsync(_editingWorkItem.Id);

        if (workItem is null)
            return;

        workItem.Name = _editingWorkItem.Name;
        workItem.Description = _editingWorkItem.Description;
        workItem.Url = _editingWorkItem.Url;
        workItem.Kind = _editingWorkItem.Kind;

        await db.SaveChangesAsync();

        _editingWorkItem = null;

        await LoadAsync();
    }

    private async Task ToggleWorkItemCompletedAsync()
    {
        await using var db =
            await DbContextFactory.CreateDbContextAsync();

        var workItem = await db.WorkItems.FindAsync(Id);

        if (workItem is null)
            return;

        workItem.CompletedAt = workItem.CompletedAt is null
            ? DateTimeOffset.UtcNow
            : null;

        await db.SaveChangesAsync();

        await LoadAsync();
    }

    private async Task ToggleWorkItemArchivedAsync()
    {
        await using var db =
            await DbContextFactory.CreateDbContextAsync();

        var workItem = await db.WorkItems.FindAsync(Id);

        if (workItem is null)
            return;

        workItem.ArchivedAt = workItem.ArchivedAt is null
            ? DateTimeOffset.UtcNow
            : null;

        await db.SaveChangesAsync();

        await LoadAsync();
    }

    private async Task CreateTodoAsync()
    {
        if (_workItem is null)
            return;

        await using var db =
            await DbContextFactory.CreateDbContextAsync();

        db.TodoItems.Add(new TodoItem
        {
            WorkItemId = _workItem.Id,
            Task = _newTodo.Task,
            Energy = _newTodo.Energy,
            Effort = _newTodo.Effort
        });

        await db.SaveChangesAsync();

        _newTodo = new TodoItem();

        await LoadAsync();
    }

    private void EditTodo(TodoItem todo)
    {
        _editingTodo = new TodoItem
        {
            Id = todo.Id,
            Task = todo.Task,
            Energy = todo.Energy,
            Effort = todo.Effort
        };
    }

    private void CancelEdit()
    {
        _editingTodo = null;
    }

    private void ConfirmDeleteTodo(int todoId)
    {
        _confirmDeleteTodoId = todoId;
    }

    private void CancelDeleteTodo()
    {
        _confirmDeleteTodoId = null;
    }

    private async Task DeleteTodoAsync(int todoId)
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();

        var todo = await db.TodoItems.FindAsync(todoId);

        if (todo is null)
            return;

        db.TodoItems.Remove(todo);

        await db.SaveChangesAsync();

        if (_editingTodo?.Id == todoId)
        {
            _editingTodo = null;
        }

        _confirmDeleteTodoId = null;

        await LoadAsync();
    }

    private async Task SaveTodoAsync()
    {
        if (_editingTodo is null)
            return;

        await using var db =
            await DbContextFactory.CreateDbContextAsync();

        var todo = await db.TodoItems.FindAsync(_editingTodo.Id);

        if (todo is null)
            return;

        todo.Task = _editingTodo.Task;
        todo.Energy = _editingTodo.Energy;
        todo.Effort = _editingTodo.Effort;

        await db.SaveChangesAsync();

        _editingTodo = null;

        await LoadAsync();
    }
    
    private async Task MarkWorkedAsync()
    {
        await using var db =
            await DbContextFactory.CreateDbContextAsync();

        var workItem = await db.WorkItems.FindAsync(Id);

        if (workItem is null)
            return;

        var workedAt = DateTimeOffset.UtcNow;

        workItem.LastWorkedAt = workedAt;

        db.WorkHistoryEntries.Add(new WorkHistoryEntry
        {
            WorkItemId = workItem.Id,
            Note = string.IsNullOrWhiteSpace(_workNote)
                ? null
                : _workNote.Trim(),
            WorkedAt = workedAt
        });

        await db.SaveChangesAsync();

        _workNote = null;

        await LoadAsync();
    }

    private async Task ToggleTodoAsync(int todoId)
    {
        await using var db =
            await DbContextFactory.CreateDbContextAsync();

        var todo = await db.TodoItems.FindAsync(todoId);

        if (todo is null)
            return;

        if (todo.CompletedAt is null)
        {
            var workedAt = DateTimeOffset.UtcNow;

            todo.CompletedAt = workedAt;

            var workItem =
                await db.WorkItems.FindAsync(todo.WorkItemId);

            if (workItem is null)
                return;

            workItem.LastWorkedAt = workedAt;

            db.WorkHistoryEntries.Add(new WorkHistoryEntry
            {
                WorkItemId = workItem.Id,
                TodoItemId = todo.Id,
                TaskSnapshot = todo.Task,
                WorkedAt = workedAt
            });
        }
        else
        {
            todo.CompletedAt = null;
        }

        await db.SaveChangesAsync();

        await LoadAsync();
    }

    private void EditHistoryNote(WorkHistoryEntry entry)
    {
        _editingHistoryId = entry.Id;
        _editingHistoryNote = entry.Note;
    }

    private void CancelHistoryNoteEdit()
    {
        _editingHistoryId = null;
        _editingHistoryNote = null;
    }

    private async Task SaveHistoryNoteAsync()
    {
        if (_editingHistoryId is null)
            return;

        await using var db = await DbContextFactory.CreateDbContextAsync();

        var entry = await db.WorkHistoryEntries.FindAsync(_editingHistoryId.Value);

        if (entry is null)
            return;

        entry.Note = string.IsNullOrWhiteSpace(_editingHistoryNote)
            ? null
            : _editingHistoryNote.Trim();

        await db.SaveChangesAsync();

        CancelHistoryNoteEdit();

        await LoadAsync();
    }
}

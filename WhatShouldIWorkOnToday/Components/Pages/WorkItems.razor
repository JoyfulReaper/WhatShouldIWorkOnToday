@page "/work-items"
@using Microsoft.EntityFrameworkCore
@using WhatShouldIWorkOnToday.Data
@using WhatShouldIWorkOnToday.Models
@inject IDbContextFactory<AppDbContext> DbContextFactory

<PageTitle>Work Items</PageTitle>

<div class="app-page">
    <header class="page-heading">
        <p class="eyebrow">The backlog</p>
        <h1>Work Items</h1>
        <p class="lead">Projects, experiments, and side quests currently competing for attention.</p>
    </header>

    <section class="panel form-panel" aria-labelledby="new-work-item-heading">
        <header class="form-panel-header">
            <h2 id="new-work-item-heading">Add a work item</h2>
            <p>Capture the useful version. You can overthink the name later.</p>
        </header>

        <EditForm Model="_newWorkItem"
                  OnValidSubmit="CreateAsync"
                  FormName="CreateWorkItem"
                  class="form-grid">
            <DataAnnotationsValidator />

            <div class="form-field">
                <label>Name</label>
                <InputText @bind-Value="_newWorkItem.Name" />
                <ValidationMessage For="() => _newWorkItem.Name" />
            </div>

            <div class="form-field">
                <label>Kind</label>
                <InputSelect @bind-Value="_newWorkItem.Kind">
                    @foreach (var value in Enum.GetValues<WorkItemKind>())
                    {
                        <option value="@value">@value</option>
                    }
                </InputSelect>
            </div>

            <div class="form-field wide">
                <label>Description</label>
                <InputTextArea @bind-Value="_newWorkItem.Description" />
                <ValidationMessage For="() => _newWorkItem.Description" />
            </div>

            <div class="form-field wide">
                <label>URL</label>
                <InputText @bind-Value="_newWorkItem.Url" />
                <ValidationMessage For="() => _newWorkItem.Url" />
            </div>

            <div class="form-actions">
                <button type="submit">Add work item</button>
            </div>
        </EditForm>
    </section>

    <section class="work-items-section" aria-labelledby="work-items-heading">
        <div class="section-header">
            <h2 id="work-items-heading">All work items</h2>
            <span class="count-label">@_workItems.Count total</span>
        </div>

        @if (_workItems.Count == 0)
        {
            <p class="empty-state">No work items yet.</p>
        }
        else
        {
            <ul class="work-item-list">
                @foreach (var workItem in _workItems)
                {
                    <li class="work-item-row">
                        <div>
                            <a class="work-item-title" href="@($"/work-items/{workItem.Id}")">
                                @workItem.Name
                            </a>

                            @if (!string.IsNullOrWhiteSpace(workItem.Description))
                            {
                                <div class="work-item-description">@workItem.Description</div>
                            }
                        </div>

                        <div class="work-item-meta">
                            <div class="badge-row">
                                <span class="badge accent">@workItem.Kind</span>

                                @if (workItem.CompletedAt is not null)
                                {
                                    <span class="badge completed">Completed</span>
                                }

                                @if (workItem.ArchivedAt is not null)
                                {
                                    <span class="badge archived">Archived</span>
                                }
                            </div>

                            @if (workItem.LastWorkedAt is not null)
                            {
                                <span class="last-worked">
                                    Last worked:
                                    @workItem.LastWorkedAt.Value.ToLocalTime().ToString("g")
                                </span>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
</div>

@code {
    private List<WorkItem> _workItems = [];
    private WorkItem _newWorkItem = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db =
            await DbContextFactory.CreateDbContextAsync();

        _workItems = await db.WorkItems
            .AsNoTracking()
            .OrderBy(x => x.Name)
            .ToListAsync();
    }

    private async Task CreateAsync()
    {
        await using var db =
            await DbContextFactory.CreateDbContextAsync();

        db.WorkItems.Add(_newWorkItem);
        await db.SaveChangesAsync();

        _newWorkItem = new WorkItem();

        await LoadAsync();
    }
}

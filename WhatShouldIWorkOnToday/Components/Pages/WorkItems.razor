@page "/work-items"
@using Microsoft.EntityFrameworkCore
@using WhatShouldIWorkOnToday.Data
@using WhatShouldIWorkOnToday.Models
@inject IDbContextFactory<AppDbContext> DbContextFactory

<PageTitle>Work Items</PageTitle>

<h1>Work Items</h1>

<EditForm Model="_newWorkItem" OnValidSubmit="CreateAsync">
    <DataAnnotationsValidator />

    <div>
        <label>Name</label>
        <InputText @bind-Value="_newWorkItem.Name" />
        <ValidationMessage For="() => _newWorkItem.Name" />
    </div>

    <div>
        <label>Description</label>
        <InputTextArea @bind-Value="_newWorkItem.Description" />
    </div>

    <div>
        <label>Kind</label>
        <InputSelect @bind-Value="_newWorkItem.Kind">
            @foreach (var value in Enum.GetValues<WorkItemKind>())
            {
                <option value="@value">@value</option>
            }
        </InputSelect>
    </div>

    <div>
        <label>Energy</label>
        <InputSelect @bind-Value="_newWorkItem.Energy">
            @foreach (var value in Enum.GetValues<EnergyLevel>())
            {
                <option value="@value">@value</option>
            }
        </InputSelect>
    </div>

    <div>
        <label>Effort</label>
        <InputSelect @bind-Value="_newWorkItem.Effort">
            @foreach (var value in Enum.GetValues<EffortLevel>())
            {
                <option value="@value">@value</option>
            }
        </InputSelect>
    </div>
    <button type="submit">Add work item</button>
</EditForm>

<hr />

@if (_workItems.Count == 0)
{
    <p>No work items yet.</p>
}
else
{
    <ul>
        @foreach (var workItem in _workItems)
        {
            <li>
                <strong>
                    <a href="@($"/work-items/{workItem.Id}")">
                        @workItem.Name
                    </a>
                </strong>

                @if (!string.IsNullOrWhiteSpace(workItem.Description))
                {
                    <div>@workItem.Description</div>
                }

                <small>
                    @workItem.Kind ·
                    @workItem.Energy energy ·
                    @workItem.Effort effort
                </small>
            </li>
        }
    </ul>
}

@code {
    private List<WorkItem> _workItems = [];
    private WorkItem _newWorkItem = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db =
            await DbContextFactory.CreateDbContextAsync();

        _workItems = await db.WorkItems
            .AsNoTracking()
            .OrderBy(x => x.Name)
            .ToListAsync();
    }

    private async Task CreateAsync()
    {
        await using var db =
            await DbContextFactory.CreateDbContextAsync();

        db.WorkItems.Add(_newWorkItem);
        await db.SaveChangesAsync();

        _newWorkItem = new WorkItem();

        await LoadAsync();
    }
}